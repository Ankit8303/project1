# ==============================================================================
# Meetup Server Environment Variables
# ==============================================================================

# Server Port (Railway provides PORT dynamically; defaults to 3000 locally)
PORT=3000

# Node Environment (production / development)
NODE_ENV=production

# Comma-separated list of allowed CORS browser origins
# In production, set this to your Railway frontend URL (e.g. https://your-frontend.up.railway.app)
ORIGINS=http://localhost:5173,http://localhost:3000

# Neon Serverless PostgreSQL connection string
# Found in Neon Console -> Connection Details (Pooled connection recommended)
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/meetup?sslmode=require

# Clerk Authentication Keys
# Found in Clerk Dashboard -> API Keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk Webhook Secret (for verifying user lifecycle webhooks at /api/clerk)
# Found in Clerk Dashboard -> Webhooks
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
