# ==============================================================================
# Meetup Client Environment Variables
# ==============================================================================

# Backend API and Socket.IO base URL
# In production, set this to your Railway backend URL (e.g. https://your-backend.up.railway.app)
VITE_BASE_URL=http://localhost:3000

# Clerk Publishable Key (from Clerk Dashboard -> API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
